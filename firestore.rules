rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lectura pública del partido y del acumulado. Crear, corregir y borrar exige sesión;
    // modificar o borrar, además, ser el autor o el admin.
    match /acta_partits/{docId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.createdBy == resource.data.createdBy
        && (resource.data.createdBy == request.auth.uid || request.auth.token.email == 'albertsinfreu@gmail.com');
      allow delete: if request.auth != null
        && (resource.data.createdBy == request.auth.uid || request.auth.token.email == 'albertsinfreu@gmail.com');
    }
  }
}
